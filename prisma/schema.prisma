datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BookingStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum NotificationType {
  BOOKING_REQUEST
  MESSAGE
  APPROVED
  DECLINED
}

enum DestinationType {
  SUN
  SNOW
  BEACH
  MOUNTAIN
  CITY
  COUNTRYSIDE
}

enum PropertyType {
  APARTMENT
  HOUSE
  CABIN
  VILLA
  BUNGALOW
}

model User {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String          @unique
  password          String
  isAdmin           Boolean         @default(false)
  bookings          Booking[]       @relation("UserBookings")       
  properties        Property[]      @relation("UserProperties")     
  sentMessages      Message[]       @relation("SentMessages")   
  receivedMessages  Message[]       @relation("ReceivedMessages") 
  notifications     Notification[]  @relation("UserNotifications")  
}

model Property {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String
  location        String
  pricePerNight   Float
  availability    Boolean
  createdAt     DateTime @default(now())
  imageUrl        String?
  destinationType DestinationType? 
  propertyType    PropertyType?
  maxGuests       Int?
  user            User?           @relation(fields: [userId], references: [id], name: "UserProperties", onDelete: Cascade)
  userId          String?         @db.ObjectId
  bookings        Booking[]       @relation("PropertyBookings")
}

model Message {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade) // här
  senderId    String   @db.ObjectId
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade) // och här
  receiverId  String   @db.ObjectId
  content     String
  timestamp   DateTime @default(now())
  notification Notification[]  @relation("MessageNotification") 
}

model Booking {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime  @default(now())
  checkInDate DateTime
  checkOutDate DateTime
  totalPrice  Float
  status      BookingStatus @default(PENDING)
  user        User     @relation(fields: [userId], references: [id], name: "UserBookings", onDelete: Cascade) // sätt `onDelete` här
  userId      String   @db.ObjectId
  property    Property @relation(fields: [propertyId], references: [id], name: "PropertyBookings", onDelete: Cascade) // och här
  propertyId  String   @db.ObjectId
  notification Notification[]  @relation("BookingNotification")
}

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  user        User             @relation(fields: [userId], references: [id], name: "UserNotifications", onDelete: Cascade)
  userId      String           @db.ObjectId
  message     String
  type        NotificationType
  booking     Booking?         @relation("BookingNotification", fields: [bookingId], references: [id])      
  bookingId   String?          @db.ObjectId
  messageRef  Message?         @relation("MessageNotification", fields: [messageId], references: [id])      
  messageId   String?          @db.ObjectId
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
}


